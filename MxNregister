// ARMv8-style register file: 32 registers x 64 bits, 2 read ports, 1 write port.
// Register 31 is XZR: always reads 0, writes to it are dropped.
module RegisterFile(
    output wire [63:0] BusA,
    output wire [63:0] BusB,
    input  wire [63:0] BusW,
    input  wire [4:0]  RA,
    input  wire [4:0]  RB,
    input  wire [4:0]  RW,
    input  wire        RegWr,
    input  wire        Clk
);

    // Storage: 32 x 64-bit. (Entry 31 is never written, and is never read.)
    reg [63:0] registers [0:31];

    // Values produced by the combinational read logic
    reg [63:0] readA, readB;

    // ---------------- Read ports (combinational, blocking) ----------------
    // Reading XZR (register 31) gives 0 no matter what is in storage.
    always @(*) begin
        if (RA == 5'd31)
            readA = 64'd0;
        else
            readA = registers[RA];

        if (RB == 5'd31)
            readB = 64'd0;
        else
            readB = registers[RB];
    end

    // #3 delay on the outputs (ignored by synthesis; avoids shoot-through in simulation)
    assign #3 BusA = readA;
    assign #3 BusB = readB;

    // ---------------- Write port (sequential, non-blocking) ----------------
    // Write on the rising clock edge only if enabled, and drop writes to XZR.
    always @(posedge Clk) begin
        if (RegWr && (RW != 5'd31))
            registers[RW] <= BusW;
    end

endmodule

 
