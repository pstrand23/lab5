`timescale 1ns / 1ps

// Exhaustive, self-checking testbench for mux2to1_8 (no ports)
module mux2to1_8_tb;

    reg  [7:0] in0, in1;
    reg        sel;
    wire [7:0] out;

    reg  [7:0] expected;
    integer    i;         // loop counter: 2^17 = 131072 combinations
    integer    errors;

    // Device under test
    mux2to1_8 dut (
        .in0 (in0),
        .in1 (in1),
        .sel (sel),
        .out (out)
    );

    // VCD dump of everything under the testbench
    initial begin
        $dumpfile("mux2to1_8.vcd");
        $dumpvars(0, mux2to1_8_tb);
    end

    // Stimulus + checking
    initial begin
        errors = 0;

        for (i = 0; i < 131072; i = i + 1) begin
            // 17 bits total: {sel, in1, in0} walks through every combination
            {sel, in1, in0} = i[16:0];

            #5;   // let the mux settle before checking

            expected = sel ? in1 : in0;

            $display("t=%0t  sel=%b in0=%h in1=%h -> out=%h (expected %h)",
                     $time, sel, in0, in1, out, expected);

            if (out !== expected) begin
                errors = errors + 1;
                $display("  *** ERROR: sel=%b in0=%h in1=%h out=%h expected=%h",
                         sel, in0, in1, out, expected);
            end
        end

        if (errors == 0)
            $display("PASS: all 131072 input combinations correct.");
        else
            $display("FAIL: %0d mismatches.", errors);

        $finish;
    end

endmodule
